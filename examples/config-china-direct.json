{
  "log": { "level": "info", "timestamp": true },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "rsq",
      "tag": "proxy",
      "server": "example.com",
      "server_port": 443,
      "password": "change-me",
      "tls": { "enabled": true, "server_name": "example.com", "insecure": true }
    }
  ],
  "route": {
    "preset": "china-direct",
    "direct_tag": "direct",
    "final": "proxy",
    "auto_detect_interface": false
  }
}
